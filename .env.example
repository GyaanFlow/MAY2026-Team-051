# Copy this file to .env and fill in real values before deploying.
FLASK_ENV=development

# Generate strong random values for production, e.g. python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=jwt-change-me-in-production

# Defaults to a local SQLite file if not set.
DATABASE_URL=sqlite:///app.db

JWT_ACCESS_TOKEN_EXPIRES_HOURS=8

# Comma-separated list of allowed origins in production, e.g. https://library.example.com
CORS_ORIGINS=*

HOST=127.0.0.1
PORT=5000
